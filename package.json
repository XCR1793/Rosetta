{
  "name": "perch",
  "version": "2.0.0",
  "description": "A sticky-note style time translator with timeline visualization and unit conversions",
  "main": "main.js",
  "scripts": {
    "start": "node launch.js",
    "dev": "electron .",
    "generate:locations": "node scripts/generate-locations.js",
    "build": "electron-builder --win && node set-icon.js",
    "package": "electron-packager . Perch --platform=win32 --arch=x64 --out=dist --overwrite --icon=Logo.ico",
    "postpackage": "node set-icon.js",
    "set-icon": "node set-icon.js"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "countries-and-timezones": "^3.9.0",
    "country-state-city": "^3.2.1",
    "electron": "^28.0.0",
    "electron-builder": "^26.0.12",
    "electron-packager": "^17.1.2",
    "geo-tz": "^8.1.8",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "com.perch.app",
    "productName": "Perch",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "Logo.ico",
      "signAndEditExecutable": false,
      "requestedExecutionLevel": "asInvoker"
    },
    "afterPack": "./scripts/after-pack.js",
    "extraResources": [
      {
        "from": "Logo.ico",
        "to": "Logo.ico"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Perch",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "license": "LICENSE",
      "installerIcon": "Logo.ico",
      "uninstallerIcon": "Logo.ico",
      "installerHeaderIcon": "Logo.ico",
      "include": "scripts/installer.nsh",
      "uninstallDisplayName": "Perch",
      "artifactName": "Perch Setup ${version}.${ext}"
    },
    "files": [
      "**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}",
      "!Documentation (Perch)/**",
      "!ARCHITECTURE.md"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "CawLabs",
        "repo": "Perch",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "js-yaml": "^4.3.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CawLabs/Perch.git"
  }
}
